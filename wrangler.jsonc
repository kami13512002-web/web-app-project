{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-project",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ae5aa888-74f8-4455-911f-d0187b63c8c8","database_name": "mango-core-luna-babddb-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b71633063ae94c92834227621401bd65" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
